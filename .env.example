# ==================================
# LLM Configuration
# ==================================

# Usar modo mock (true/false)
USE_MOCK=true

# Provider LLM: mock, openrouter, anthropic
LLM_PROVIDER=openrouter

# Modelo a ser usado (depende do provider)
LLM_MODEL=google/gemini-2.5-flash

# Timeout para chamadas LLM em milissegundos
LLM_TIMEOUT_MS=60000

# Número de tentativas em caso de JSON inválido
LLM_RETRY_ON_INVALID_JSON=1

# ==================================
# OpenRouter (Multi-provider)
# ==================================
# Obter API key em: https://openrouter.ai/keys

OPENROUTER_API_KEY=
OPENROUTER_APP_URL=https://github.com/your-username/your-repo
OPENROUTER_APP_NAME=Your App Name

# ==================================
# Anthropic Claude (Direct API)
# ==================================
# Obter API key em: https://console.anthropic.com/

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1200

# ==================================
# Database Configuration
# ==================================

# URL do banco de dados PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# URL direta para migrations (sem pooler)
DIRECT_URL="postgresql://username:password@localhost:5432/database_name"

# ==================================
# Authentication
# ==================================

# Secret para NextAuth.js (gerar com: openssl rand -base64 32)
AUTH_SECRET=

# URL base da aplicação
NEXTAUTH_URL="http://localhost:3000"

# ==================================
# Development & Debug
# ==================================

# Ambiente de execução
NODE_ENV=development

# Habilitar debug de minificação
DEBUG_MINIFY=false